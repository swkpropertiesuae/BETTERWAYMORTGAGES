# Public Betterway OS base URL (used for Client Portal, RERA Partner Hub & Staff OS links)
NEXT_PUBLIC_OS_URL=https://betterwayos.vercel.app

# Server-side Betterway OS intake base URL (defaults to NEXT_PUBLIC_OS_URL if unset)
BW_OS_INTERNAL_URL=https://betterwayos.vercel.app

# Shared HMAC-SHA256 webhook secret — must match BETTERWAYOS BW_INTAKE_HMAC_SECRET
BW_INTAKE_HMAC_SECRET=

# Optional verified corporate contact details (leave blank until confirmed)
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_LICENCE=
